<Application x:Class="iPhotoBackupSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#2FB350" />
            <SolidColorBrush x:Key="WarningBrush" Color="#D9822B" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
