<Window x:Class="iPhotoBackupSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:iPhotoBackupSync.App.ViewModels"
        xmlns:conv="clr-namespace:iPhotoBackupSync.App.Converters"
        Title="iPhoto Backup Sync" Height="780" Width="1180" MinHeight="500" MinWidth="820">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:SyncStatusToBrushConverter x:Key="SyncStatusToBrush" />
        <conv:SyncStatusToTextConverter x:Key="SyncStatusToText" />
        <conv:DepthToIndentConverter x:Key="DepthToIndent" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="SortableHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click to sort. Shift+click to add as a secondary sort." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Content" Value="▸" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="▾" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SyncDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{Binding SyncStatus, Converter={StaticResource SyncStatusToBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncStatus}" Value="Refreshing">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.25" Duration="0:0:0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folder pickers -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Origin (e.g. iCloud Photos):" VerticalAlignment="Center" Width="180" />
            <TextBox Grid.Column="1" Text="{Binding OriginPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource IconButton}" Command="{Binding BrowseOriginCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Destination (backup / NAS):" VerticalAlignment="Center" Width="180" />
            <TextBox Grid.Column="1" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource IconButton}" Command="{Binding BrowseDestinationCommand}" />
        </Grid>

        <!-- Actions row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Compare" Style="{StaticResource IconButton}" Command="{Binding CompareCommand}" FontWeight="Bold" />
            <Button Content="Cancel" Style="{StaticResource IconButton}" Command="{Binding CancelCommand}" />
            <Separator Width="16" Background="Transparent" />
            <Button Content="Expand All" Style="{StaticResource IconButton}" Command="{Binding ExpandAllCommand}" />
            <Button Content="Collapse All" Style="{StaticResource IconButton}" Command="{Binding CollapseAllCommand}" />
            <Separator Width="16" Background="Transparent" />
            <Button Content="Select All" Style="{StaticResource IconButton}" Command="{Binding SelectAllCommand}" />
            <Button Content="Clear Selection" Style="{StaticResource IconButton}" Command="{Binding ClearSelectionCommand}" />
            <Separator Width="16" Background="Transparent" />
            <Button Content="Copy Selected to Destination" Style="{StaticResource IconButton}" Command="{Binding CopySelectedCommand}" />
            <Button Content="Export List (CSV)" Style="{StaticResource IconButton}" Command="{Binding ExportCsvCommand}" />
            <TextBlock Text="{Binding ResultsSummary}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Filter / sort row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filter:" VerticalAlignment="Center" />
            <TextBox Width="220" Margin="6,0,0,0" VerticalAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by file/folder name (contains)" />
            <TextBlock Text="Modified from:" VerticalAlignment="Center" Margin="14,0,0,0" />
            <DatePicker Width="120" Margin="6,0,0,0" SelectedDate="{Binding FilterDateFrom}" />
            <TextBlock Text="to:" VerticalAlignment="Center" Margin="10,0,0,0" />
            <DatePicker Width="120" Margin="6,0,0,0" SelectedDate="{Binding FilterDateTo}" />
            <TextBlock Text="Cloud sync:" VerticalAlignment="Center" Margin="14,0,0,0" />
            <CheckBox Content="Refreshing" VerticalAlignment="Center" Margin="6,0,0,0" IsChecked="{Binding FilterSyncRefreshing}" />
            <CheckBox Content="Synced" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding FilterSyncSynced}" />
            <CheckBox Content="Not synced" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding FilterSyncNotSynced}" />
            <CheckBox Content="Error" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding FilterSyncError}" />

            <Button Content="Clear Filters" Style="{StaticResource IconButton}" Command="{Binding ClearFiltersCommand}" Margin="14,0,0,0" />
        </StackPanel>

        <!-- Results list -->
        <Border Grid.Row="4" BorderBrush="#33000000" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="#11000000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="2" Style="{StaticResource SortableHeaderButton}"
                            Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static vm:SortField.Name}">
                        <TextBlock><Run Text="Name" /><Run Text=" " /><Run Text="{Binding NameSortGlyph, Mode=OneWay}" /></TextBlock>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource SortableHeaderButton}"
                            Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static vm:SortField.Size}">
                        <TextBlock><Run Text="Size" /><Run Text=" " /><Run Text="{Binding SizeSortGlyph, Mode=OneWay}" /></TextBlock>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource SortableHeaderButton}"
                            Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static vm:SortField.LastModified}">
                        <TextBlock><Run Text="Last Modified" /><Run Text=" " /><Run Text="{Binding LastModifiedSortGlyph, Mode=OneWay}" /></TextBlock>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource SortableHeaderButton}"
                            Command="{Binding SortByColumnCommand}" CommandParameter="{x:Static vm:SortField.SyncStatus}">
                        <TextBlock><Run Text="Cloud Sync" /><Run Text=" " /><Run Text="{Binding SyncStatusSortGlyph, Mode=OneWay}" /></TextBlock>
                    </Button>
                </Grid>

                <ListBox Grid.Row="1" x:Name="ResultsListBox"
                         ItemsSource="{Binding FlattenedItems}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileNodeViewModel}">
                            <Grid Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsThreeState="True"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <ToggleButton Grid.Column="1" Style="{StaticResource ExpanderToggle}"
                                              IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"
                                              IsEnabled="{Binding DataContext.IsFilterActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolean}}"
                                              Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding RelativePath}" />
                                    <TextBlock Text="{Binding MissingSummary}" Margin="8,0,0,0"
                                               Foreground="#8A8A8E" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" Padding="6,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding LastModifiedDisplay}" Padding="6,4" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                            ToolTip="{Binding SyncStatus, Converter={StaticResource SyncStatusToText}}">
                                    <Ellipse Style="{StaticResource SyncDot}" />
                                    <TextBlock Text="{Binding SyncStatus, Converter={StaticResource SyncStatusToText}}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reveal in File Explorer"
                                                  Command="{Binding DataContext.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Copy Full Path"
                                                  Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Progress -->
        <TextBlock Grid.Row="5" Text="{Binding ProgressDetail}" Margin="0,8,0,0" Foreground="#0A84FF" />
        <ProgressBar Grid.Row="5" Height="4" Margin="0,26,0,0"
                     IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Status bar -->
        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
